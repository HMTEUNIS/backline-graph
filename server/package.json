{
  "name": "backline-graph-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only GraphQL over Backline's label schema.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
