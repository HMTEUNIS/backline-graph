  },
  "dependencies": {
    "@pothos/core": "^4.10.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
